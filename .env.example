# ---------------------------------------------------------------------------
# Variables para docker-compose.yml (producción)
#   cp .env.example .env   y llena los valores. NUNCA subas .env a git.
# ---------------------------------------------------------------------------

# Dominio público (sin https://), el mismo que configures en Nginx
DOMAIN=migajero.ejemplo.com

# --- Base de datos PostgreSQL (solo accesible dentro de Docker) ---
POSTGRES_DB=migajero
POSTGRES_USER=migajero
# Solo letras y números (va dentro de una URL). Genera una con:  openssl rand -hex 32
POSTGRES_PASSWORD=

# --- Django ---
# Genera una con:  openssl rand -base64 48
DJANGO_SECRET_KEY=
# Ruta del panel de administración: usa una difícil de adivinar. Genera con:  echo "panel-$(openssl rand -hex 6)/"
ADMIN_URL=admin/
# Días que dura una sesión antes de pedir login otra vez
TOKEN_TTL_DAYS=30
# Procesos de gunicorn (~60-80 MB de RAM cada uno)
WEB_CONCURRENCY=2

# --- Puertos en el servidor (solo 127.0.0.1; Nginx los expone) ---
FRONTEND_PORT=3030
BACKEND_PORT=8030

# --- Respaldos de la base de datos ---
BACKUP_SCHEDULE=@daily
BACKUP_KEEP_DAYS=7
BACKUP_KEEP_WEEKS=4
BACKUP_KEEP_MONTHS=3
