# Copia este archivo a .env (no se sube a git) o define las variables en tu servidor.

DEBUG=True
DJANGO_SECRET_KEY=cambia-esto-por-una-llave-larga-y-aleatoria
ALLOWED_HOSTS=localhost,127.0.0.1

# Sin DATABASE_URL se usa SQLite (backend/db.sqlite3)
# DATABASE_URL=postgres://usuario:password@host:5432/basededatos
# DATABASE_SSL=True

# Producción (separados por coma). Con Docker + Nginx (mismo dominio) CORS no hace falta.
# CORS_ALLOWED_ORIGINS=https://mi-frontend.netlify.app
# CSRF_TRUSTED_ORIGINS=https://mi-dominio.com

# Detrás de Nginx: 1 (para que el límite de peticiones use la IP real del cliente)
# NUM_PROXIES=1
# Contador compartido del límite de peticiones (obligatorio con varios workers)
# REDIS_URL=redis://localhost:6379/0
# Ruta secreta del panel de administración
# ADMIN_URL=admin/
# Días que dura una sesión
# TOKEN_TTL_DAYS=30

# Procesos de gunicorn (cada uno usa ~60-80 MB de RAM)
# WEB_CONCURRENCY=2
