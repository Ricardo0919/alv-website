# Copia este archivo a .env.local

# Local (recomendado): déjalo vacío. El navegador llama a /api y Next.js lo
# reenvía al backend, así también funciona desde otros dispositivos de tu red.
NEXT_PUBLIC_API_URL=
# A dónde reenvía Next.js las peticiones /api cuando NEXT_PUBLIC_API_URL está vacío
API_PROXY_TARGET=http://127.0.0.1:8000

# Producción (Netlify): URL pública del backend, sin /api al final
# NEXT_PUBLIC_API_URL=https://alv-website.onrender.com
